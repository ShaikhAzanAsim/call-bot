# Copy to .env. Never commit .env.

# development | test | production
APP_ENV=development

# SQLite file (WAL) or postgresql+psycopg://user:pass@host:5432/patients
DATABASE_URL=sqlite:///./data/patients.db

# Insert Jane Doe and Carlos Rivera when the patients table is empty.
SEED_ON_STARTUP=true

# Required in production. Vapi sends this as X-Vapi-Secret or Authorization: Bearer.
# Also accepted as ?token= on the webhook URL.
VAPI_WEBHOOK_SECRET=

# When set, assistant-request returns this saved assistant plus per-call overrides.
# When empty, the webhook returns a transient assistant (local dev).
VAPI_ASSISTANT_ID=

# Live-call model configured inside the Vapi assistant. Low latency over raw intelligence.
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot

# Public origin with no trailing slash, used to build the tool server URL.
# Example: https://your-app.up.railway.app
PUBLIC_BASE_URL=

# Offer to resume a dropped call for this many hours.
DRAFT_RESUME_HOURS=24

# Census geocoder timeout. On timeout or error we use the bundled ZIP3 table.
CENSUS_TIMEOUT_SECONDS=1.5

# Force patient writes to fail so you can hear the spoken error. Keep false in production.
SIMULATE_DB_WRITE_FAILURE=false

LOG_LEVEL=INFO

# Eval Lab LLM mode only (python -m evals.run --llm). Any OpenAI-compatible API.
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=https://api.openai.com/v1
EVAL_LLM_MODEL=gpt-4o-mini
